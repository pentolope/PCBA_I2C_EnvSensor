      "generated/routing.json"
    ],
    "required_domains": [
      "claims",
      "simulation",
      "timing"
    ],
    "declined_domains": [
      {
        "domain": "requirements",
        "reason": "no requirement register is authored yet; every claim cites the brief and the frozen datasheets in its own requirement source, and the register lands with a later revision"
      },
      {
        "domain": "device_parameters",
        "reason": "the parameters this board's claims rest on live in components/parameters.json with per-figure document citations; none is a typical-only figure a knowledge level would demote"
      },
      {
        "domain": "orientation",
        "reason": "no part on this board needs a rotation correction; the CPL ships library angles and the fabrication order review checks the preview"
      },
      {
        "domain": "thermal",
        "reason": "U2 publishes no junction-to-ambient thermal resistance in its frozen datasheet, so THERMAL.DERATING and THERMAL.JUNCTION refuse it, and declaring thermal.parts without U2 would state a dissipation inventory that omits a real source. The board's own thermal requirement is carried by the validated claim steady_rise_above_ambient_at_the_humidity_sensor, a 2.6 mK upper bound against a 50 mK budget, over a total board dissipation of 25.6 uW"
      },
      {
        "domain": "current_capacity",
        "reason": "peak board current is 4.0 mA. IPC-2221's curve is fitted over cross-sections down to 1 mil2, and the section 4 mA demands at any rise inside the fitted window is about 0.008 mil2, so required_area_mm2 refuses it as an extrapolation. The requirement the domain would serve, that the board's current stays inside what the connector and host carry, is settled by the validated claim peak_board_supply_current against the connector's 2 A contact rating"
      },
      {
        "domain": "differential_pairs",
        "reason": "no differential pair is routed on this board; the only bus is single-ended I2C and the remaining nets are the supply and its return"
      }
    ]
  },
